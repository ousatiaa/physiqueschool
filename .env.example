# Supabase (https://supabase.com > Project Settings > API)
# URL du projet
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique anon (commence par eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-annon-key
# Clé service role (côté serveur uniquement, ne jamais exposer)
SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key

# JWT secret pour l'authentification (changez cette valeur aléatoire)
JWT_SECRET=your-super-secret-key-here

# URL du site (votre domaine Vercel)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
